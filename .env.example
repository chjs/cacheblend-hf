# Copy to .env and fill in your values. .env is gitignored.

# HuggingFace Hub token (for downloading gated models like Mistral-7B-Instruct-v0.2)
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Gmail address used to send phase reports
GMAIL_ADDRESS=

# Gmail APP password (NOT your regular password!)
# Create here: https://myaccount.google.com/apppasswords
# Requires 2FA enabled.
GMAIL_APP_PASSWORD=

# Where reports should go
REPORT_EMAIL_TO=ch.jungsik@gmail.com

# ----- vast.ai settings (used by scripts/vast.sh) -----
# Override defaults if you want different instance specs.
# VAST_DISK_GB=80
# VAST_IMAGE=pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime
# VAST_REMOTE_PATH=/workspace/cacheblend-hf

# vast.ai API key — only needed if `vastai` CLI isn't already authenticated.
# If you've already done `vastai set api-key …`, leave this blank.
# VAST_API_KEY=
